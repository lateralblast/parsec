source "https://rubygems.org"

# nokogiri and rmagick require Ruby >= 3.2; Ruby's system-bundled version on
# some platforms (e.g. macOS's stock Ruby) is older and will fail to install these.
ruby ">= 3.2.0"

# Required for text/table/csv/pipe output and core reporting (parsec.rb)
gem "csv" # no longer a default gem as of Ruby 3.4
gem "getopt"
gem "iconv"
gem "fileutils"
gem "hex_string"
gem "terminal-table"
gem "unpack"
gem "enumerate"

# Required for PDF output (parsec.rb --format=pdf)
gem "prawn"
gem "prawn-table"
gem "fastimage"
gem "nokogiri"
gem "rmagick"

# Required for the Sinatra webserver (webserver.rb)
gem "sinatra"
gem "bcrypt"
gem "webrick"
gem "rackup"
